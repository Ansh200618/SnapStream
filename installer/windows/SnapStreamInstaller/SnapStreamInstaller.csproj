<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SnapStream</AssemblyName>
    <RootNamespace>SnapStreamInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>SnapStream.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Version>2.1.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <Product>SnapStream</Product>
    <Company>SnapStream</Company>
    <Description>SnapStream Windows extension manager and updater</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\..\images\icon_128.png"><Link>Assets\icon_128.png</Link></Resource>
    <Resource Include="SnapStream.ico"><Link>Assets\SnapStream.ico</Link></Resource>
  </ItemGroup>
</Project>
