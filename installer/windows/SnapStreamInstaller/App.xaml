<Application x:Class="SnapStreamInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Accent" Color="#6558FF"/>
    <SolidColorBrush x:Key="Accent2" Color="#4E8CFF"/>
    <SolidColorBrush x:Key="Ink" Color="#151826"/>
    <SolidColorBrush x:Key="Muted" Color="#6F7487"/>
    <SolidColorBrush x:Key="Line" Color="#E2E5EE"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F8F9FD"/>

    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Application.Resources>
</Application>
