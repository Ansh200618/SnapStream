<Window x:Class="SnapStreamInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapStream Setup" Width="920" Height="650" MinWidth="820" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="#F5F6FB" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#6558FF"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#444A60"/>
      <Setter Property="Background" Value="#FFFFFF"/>
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="18"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="24" Padding="22">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
          <Border Width="44" Height="44" CornerRadius="14" Background="#6558FF">
            <Image Source="Assets/icon_128.png" Margin="8"/>
          </Border>
          <StackPanel Margin="12,4,0,0">
            <TextBlock Text="SnapStream" FontWeight="Bold" FontSize="17" Foreground="#151826"/>
            <TextBlock Text="Windows Installer" FontSize="11" Foreground="#7A8092"/>
          </StackPanel>
        </StackPanel>

        <TextBlock Text="Install once. Update anytime." FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Foreground="#151826"/>
        <TextBlock Margin="0,10,0,22" Text="SnapStream is stored in a permanent app-data folder. Future updates replace the same extension files from GitHub." FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="#6F7487"/>

        <Border Background="#F4F2FF" CornerRadius="16" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Permanent extension folder" FontSize="10" FontWeight="SemiBold" Foreground="#6558FF"/>
            <TextBlock x:Name="InstallPathText" Margin="0,5,0,0" FontSize="10" TextWrapping="Wrap" Foreground="#555B70"/>
          </StackPanel>
        </Border>

        <Border Background="#F8F9FD" CornerRadius="16" Padding="14">
          <StackPanel>
            <TextBlock Text="First install note" FontSize="10" FontWeight="SemiBold" Foreground="#151826"/>
            <TextBlock Margin="0,5,0,0" Text="Chrome requires one manual Load unpacked approval for off-store extensions. Updates after that stay in the same folder." FontSize="10" TextWrapping="Wrap" LineHeight="16" Foreground="#6F7487"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Setup &amp; Updates" FontSize="28" FontWeight="Bold" Foreground="#151826"/>
        <TextBlock Text="Detect a browser, install the latest GitHub build, and keep SnapStream updated." Margin="0,6,0,22" Foreground="#6F7487" FontSize="12"/>

        <Border Background="#FFFFFF" CornerRadius="22" Padding="20" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Version status" FontWeight="SemiBold" FontSize="12" Foreground="#6558FF"/>
              <TextBlock x:Name="VersionTitle" Text="Checking GitHub…" FontWeight="Bold" FontSize="20" Margin="0,5,0,0" Foreground="#151826"/>
              <TextBlock x:Name="VersionDetail" Text="Please wait" FontSize="11" Margin="0,4,0,0" Foreground="#6F7487"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="CheckButton" Style="{StaticResource SecondaryButton}" Content="Check updates" Click="CheckButton_Click"/>
          </Grid>
        </Border>

        <Border Background="#FFFFFF" CornerRadius="22" Padding="20" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Detected browsers" FontWeight="Bold" FontSize="16" Foreground="#151826"/>
            <TextBlock Text="Choose where you want to open SnapStream setup." FontSize="11" Foreground="#6F7487" Margin="0,4,0,14"/>
            <ItemsControl x:Name="BrowserList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#F8F9FD" CornerRadius="14" Padding="12" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#151826"/>
                        <TextBlock Text="{Binding ExePath}" FontSize="9" Foreground="#8A90A2" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <RadioButton Grid.Column="1" GroupName="browser" IsChecked="{Binding IsSelected}" Checked="Browser_Checked" Tag="{Binding}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Background="#FFFFFF" CornerRadius="22" Padding="20">
          <StackPanel>
            <TextBlock Text="Install / Update" FontWeight="Bold" FontSize="16" Foreground="#151826"/>
            <TextBlock x:Name="StatusText" Text="Ready" Margin="0,5,0,12" FontSize="11" Foreground="#6F7487" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,16"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button x:Name="InstallButton" Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Install latest" Click="InstallButton_Click"/>
              <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Open extensions page" Click="OpenExtensions_Click"/>
            </Grid>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Open installed folder" Click="OpenFolder_Click"/>
              <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy folder path" Click="CopyPath_Click"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
