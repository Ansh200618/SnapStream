<Window x:Class="SnapStreamInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapStream" Width="1140" Height="760" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Segoe UI Variable, Segoe UI" Icon="Assets/SnapStream.ico">
  <Window.Resources>
    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,11"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#5C49F2"/>
      <Setter Property="BorderBrush" Value="#5C49F2"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="#1E293B"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#DDE3EE"/>
    </Style>
    <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="#5C49F2"/>
      <Setter Property="Background" Value="#EFECFF"/>
      <Setter Property="BorderBrush" Value="#DDD7FF"/>
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#111827" Padding="24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="52" Height="52" CornerRadius="16" Background="#FFFFFF">
              <Image Source="Assets/icon_128.png" Margin="8"/>
            </Border>
            <StackPanel Margin="13,5,0,0">
              <TextBlock Text="SnapStream" Foreground="White" FontWeight="Bold" FontSize="21"/>
              <TextBlock Text="Windows Manager" Foreground="#9CA3AF" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>

          <Border Background="#1F2937" CornerRadius="18" Padding="16" Margin="0,28,0,0">
            <StackPanel>
              <TextBlock Text="INSTALLED EXTENSION" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold"/>
              <TextBlock x:Name="SideVersionText" Text="Checking..." Foreground="White" FontWeight="SemiBold" FontSize="18" Margin="0,8,0,0"/>
              <TextBlock x:Name="SideVersionDetail" Text="Waiting for GitHub status" Foreground="#AAB2C3" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <Border Background="#182132" CornerRadius="18" Padding="16" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="EXTENSION FOLDER" Foreground="#A5B4FC" FontSize="11" FontWeight="Bold"/>
              <TextBlock x:Name="InstallPathText" Text="Loading path..." Foreground="#D6DAE5" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,26,0,0">
          <Button Style="{StaticResource PrimaryButton}" Content="Install / Update latest" Click="InstallButton_Click" x:Name="InstallButton" Margin="0,0,0,10"/>
          <Button Style="{StaticResource SoftButton}" Content="Start browser activation guide" Click="GuidedSetup_Click" Margin="0,0,0,10"/>
          <Button Style="{StaticResource SecondaryButton}" Content="Check for updates" Click="CheckButton_Click" x:Name="CheckButton"/>
        </StackPanel>

        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
          <Border Background="#172033" CornerRadius="18" Padding="16">
            <StackPanel>
              <TextBlock Text="Security note" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="Chrome-based browsers require one manual Load unpacked approval for off-store extensions. SnapStream keeps all future updates in the same permanent folder." Foreground="#AAB2C3" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Built from your public GitHub repo" Foreground="#6B7280" FontSize="11" Margin="0,20,0,0"/>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Background="#F4F6FA">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
          <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Setup &amp; Updates" Foreground="#111827" FontSize="34" FontWeight="Bold"/>
              <TextBlock Text="Install SnapStream once, activate it in your browser once, then update from GitHub without downloading ZIP files again." Foreground="#64748B" FontSize="14" TextWrapping="Wrap" MaxWidth="690" LineHeight="22" Margin="0,6,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="14,10" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#22C55E" Margin="0,0,8,0"/>
                <TextBlock x:Name="TopStatus" Text="Checking GitHub..." Foreground="#334155" FontWeight="SemiBold" FontSize="13"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="22" Padding="20">
              <StackPanel>
                <TextBlock Text="LOCAL VERSION" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="LocalVersionText" Text="Checking" Foreground="#111827" FontSize="28" FontWeight="Bold" Margin="0,7,0,0"/>
                <TextBlock Text="Installed on this PC" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="22" Padding="20">
              <StackPanel>
                <TextBlock Text="GITHUB VERSION" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="RemoteVersionText" Text="Checking" Foreground="#111827" FontSize="28" FontWeight="Bold" Margin="0,7,0,0"/>
                <TextBlock Text="Latest main branch build" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="22" Padding="20">
              <StackPanel>
                <TextBlock Text="SELECTED BROWSER" Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="SelectedBrowserText" Text="Detecting" Foreground="#111827" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock Text="Used for activation guide" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="24" Padding="22" Margin="0,0,0,18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Version status" Foreground="#5C49F2" FontSize="12" FontWeight="Bold"/>
                <TextBlock x:Name="VersionTitle" Text="Checking GitHub..." Foreground="#111827" FontWeight="Bold" FontSize="24" Margin="0,6,0,0"/>
                <TextBlock x:Name="VersionDetail" Text="Please wait while SnapStream checks the latest extension build." Foreground="#64748B" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Check now" Click="CheckButton_Click" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="24" Padding="22" Margin="0,0,0,18">
            <StackPanel>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Detected browsers" Foreground="#111827" FontWeight="Bold" FontSize="20"/>
                  <TextBlock x:Name="BrowserSummary" Text="Scanning this PC..." Foreground="#64748B" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Rescan" Click="RescanBrowsers_Click"/>
              </Grid>
              <ItemsControl x:Name="BrowserList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="255" MinHeight="112" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="15" Margin="0,0,12,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" Foreground="#111827" FontWeight="Bold" FontSize="15"/>
                          <TextBlock Text="{Binding VersionText}" Foreground="#5C49F2" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                          <TextBlock Text="{Binding ExePath}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                        </StackPanel>
                        <RadioButton Grid.Column="1" GroupName="browser" IsChecked="{Binding IsSelected}" Checked="Browser_Checked" Tag="{Binding}" VerticalAlignment="Top" Margin="10,2,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="24" Padding="22" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="First-time browser activation" Foreground="#5C49F2" FontSize="12" FontWeight="Bold"/>
              <TextBlock Text="A guided setup that does not hide behind the browser" Foreground="#111827" FontWeight="Bold" FontSize="22" Margin="0,6,0,0"/>
              <TextBlock Text="The app now shows every step inside SnapStream first. The browser opens only after the user presses the final button inside the activation guide." Foreground="#64748B" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,16"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16">
                  <StackPanel>
                    <TextBlock Text="01" Foreground="#5C49F2" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="Install files" Foreground="#111827" FontWeight="Bold" FontSize="15" Margin="0,6,0,0"/>
                    <TextBlock Text="SnapStream downloads the real extension from GitHub and stores it in the permanent local folder." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16">
                  <StackPanel>
                    <TextBlock Text="02" Foreground="#5C49F2" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="Show guide" Foreground="#111827" FontWeight="Bold" FontSize="15" Margin="0,6,0,0"/>
                    <TextBlock Text="The instructions stay visible in the app before the browser setup page opens." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16">
                  <StackPanel>
                    <TextBlock Text="03" Foreground="#5C49F2" FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="Activate once" Foreground="#111827" FontWeight="Bold" FontSize="15" Margin="0,6,0,0"/>
                    <TextBlock Text="User enables Developer mode and chooses Load unpacked once. Future updates reuse the same folder." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>

              <Button Style="{StaticResource PrimaryButton}" Content="Open activation guide" Click="GuidedSetup_Click" Margin="0,16,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="24" Padding="22">
            <StackPanel>
              <TextBlock Text="Install / Update actions" Foreground="#111827" FontWeight="Bold" FontSize="20"/>
              <TextBlock x:Name="StatusText" Text="Ready" Foreground="#64748B" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,14"/>
              <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,16"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.4*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="InstallButtonSecondary" Style="{StaticResource PrimaryButton}" Content="Install latest extension" Click="InstallButton_Click"/>
                <Button Grid.Column="2" Style="{StaticResource SoftButton}" Content="Open activation guide" Click="GuidedSetup_Click"/>
              </Grid>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Open extension folder" Click="OpenFolder_Click"/>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy folder path" Click="CopyPath_Click"/>
                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="Open extensions page" Click="OpenExtensions_Click"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="DialogOverlay" Grid.ColumnSpan="2" Background="#990F172A" Visibility="Collapsed" Panel.ZIndex="100">
      <Border Width="520" Background="White" CornerRadius="26" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="DialogKicker" Text="Status" Foreground="#5C49F2" FontSize="12" FontWeight="Bold"/>
          <TextBlock x:Name="DialogTitle" Text="SnapStream status" Foreground="#111827" FontWeight="Bold" FontSize="26" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock x:Name="DialogBody" Text="Details" Foreground="#64748B" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,22"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DialogSecondaryButton" Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Close" Click="DialogSecondaryButton_Click"/>
            <Button x:Name="DialogPrimaryButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="OK" Click="DialogPrimaryButton_Click"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="ActivationOverlay" Grid.ColumnSpan="2" Background="#990F172A" Visibility="Collapsed" Panel.ZIndex="110">
      <Border Width="720" Background="White" CornerRadius="28" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Browser activation guide" Foreground="#5C49F2" FontSize="12" FontWeight="Bold"/>
              <TextBlock Text="Finish SnapStream setup once" Foreground="#111827" FontWeight="Bold" FontSize="28" Margin="0,8,0,0"/>
              <TextBlock x:Name="ActivationBrowserName" Text="Selected browser" Foreground="#64748B" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource TextButton}" Content="Close" Click="ActivationClose_Click"/>
          </Grid>

          <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,20,0,16">
            <StackPanel>
              <TextBlock Text="Folder copied to clipboard" Foreground="#16A34A" FontWeight="Bold" FontSize="13"/>
              <TextBlock x:Name="ActivationPathText" Text="Extension path" Foreground="#334155" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16">
              <StackPanel>
                <TextBlock Text="1" Foreground="#5C49F2" FontWeight="Bold" FontSize="24"/>
                <TextBlock Text="Open extensions page" Foreground="#111827" FontWeight="Bold" FontSize="15" Margin="0,6,0,0"/>
                <TextBlock Text="Press the button below after reading these steps." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16">
              <StackPanel>
                <TextBlock Text="2" Foreground="#5C49F2" FontWeight="Bold" FontSize="24"/>
                <TextBlock Text="Enable Developer mode" Foreground="#111827" FontWeight="Bold" FontSize="15" Margin="0,6,0,0"/>
                <TextBlock Text="Turn on the browser Developer mode toggle." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16">
              <StackPanel>
                <TextBlock Text="3" Foreground="#5C49F2" FontWeight="Bold" FontSize="24"/>
                <TextBlock Text="Load unpacked" Foreground="#111827" FontWeight="Bold" FontSize="15" Margin="0,6,0,0"/>
                <TextBlock Text="Click Load unpacked and select the copied SnapStream Extension folder." Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Copy folder path again" Click="CopyPath_Click"/>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="I understand — open browser setup" Click="LaunchActivationBrowser_Click"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>