<Window x:Class="SnapStreamInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapStream" Width="1080" Height="720" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F5F6FB" FontFamily="Segoe UI" Icon="Assets/SnapStream.ico">
  <Window.Resources>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#6558FF"/>
      <Setter Property="Padding" Value="18,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Foreground" Value="#444A60"/><Setter Property="Background" Value="#F7F8FC"/></Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Foreground" Value="#6558FF"/><Setter Property="Background" Value="#F0EEFF"/></Style>
  </Window.Resources>

  <Grid Margin="22">
    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="26" Padding="22">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="48" Height="48" CornerRadius="15" Background="#6558FF"><Image Source="Assets/icon_128.png" Margin="8"/></Border>
          <StackPanel Margin="12,5,0,0"><TextBlock Text="SnapStream" FontWeight="Bold" FontSize="18" Foreground="#151826"/><TextBlock Text="Windows Manager" FontSize="10" Foreground="#7A8092"/></StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,30,0,0">
          <TextBlock Text="Extension control center" FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Foreground="#151826"/>
          <TextBlock Margin="0,9,0,0" Text="Install SnapStream once, keep the same permanent extension folder, and pull future builds directly from GitHub." FontSize="11" TextWrapping="Wrap" LineHeight="18" Foreground="#6F7487"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,26,0,0">
          <Border Background="#F2F0FF" CornerRadius="16" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="EXTENSION LOCATION" FontSize="8" FontWeight="Bold" Foreground="#6558FF"/><TextBlock x:Name="InstallPathText" Margin="0,5,0,0" FontSize="9" TextWrapping="Wrap" Foreground="#555B70"/></StackPanel></Border>
          <Border Background="#F8F9FD" CornerRadius="16" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="APP BEHAVIOR" FontSize="8" FontWeight="Bold" Foreground="#151826"/><TextBlock Text="Checks GitHub automatically every time you open SnapStream." Margin="0,5,0,0" FontSize="10" TextWrapping="Wrap" LineHeight="16" Foreground="#6F7487"/></StackPanel></Border>
          <Border Background="#FFF8E8" CornerRadius="16" Padding="14"><StackPanel><TextBlock Text="BROWSER SECURITY" FontSize="8" FontWeight="Bold" Foreground="#9A6500"/><TextBlock Text="Chrome-based browsers require one manual Developer mode + Load unpacked approval for off-store extensions. SnapStream guides that step and keeps all later updates in the same folder." Margin="0,5,0,0" FontSize="10" TextWrapping="Wrap" LineHeight="16" Foreground="#77694F"/></StackPanel></Border>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="SnapStream for Windows" Foreground="#A0A5B4" FontSize="9"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid Margin="0,2,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Setup &amp; Updates" FontSize="30" FontWeight="Bold" Foreground="#151826"/><TextBlock Text="Your installed SnapStream build, browser setup, and updates in one place." Margin="0,5,0,0" Foreground="#6F7487" FontSize="11"/></StackPanel>
          <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="14" Padding="14,9"><TextBlock x:Name="TopStatus" Text="Checking GitHub…" FontSize="10" FontWeight="SemiBold" Foreground="#6558FF"/></Border>
        </Grid>

        <Border Background="#FFFFFF" CornerRadius="22" Padding="20" Margin="0,0,0,14">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="VERSION STATUS" FontWeight="Bold" FontSize="9" Foreground="#6558FF"/><TextBlock x:Name="VersionTitle" Text="Checking GitHub…" FontWeight="Bold" FontSize="21" Margin="0,5,0,0" Foreground="#151826"/><TextBlock x:Name="VersionDetail" Text="Please wait" FontSize="10" Margin="0,4,0,0" Foreground="#6F7487"/></StackPanel>
            <Button Grid.Column="1" x:Name="CheckButton" Style="{StaticResource SecondaryButton}" Content="Check now" Click="CheckButton_Click" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <Border Background="#FFFFFF" CornerRadius="22" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Detected browsers" FontWeight="Bold" FontSize="16" Foreground="#151826"/><TextBlock x:Name="BrowserSummary" Text="Scanning this PC…" FontSize="10" Foreground="#6F7487" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Rescan" Click="RescanBrowsers_Click"/></Grid>
            <ItemsControl x:Name="BrowserList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
              <Border Width="245" MinHeight="94" Background="#F8F9FD" CornerRadius="15" Padding="13" Margin="0,0,10,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#151826"/><TextBlock Text="{Binding VersionText}" FontSize="9" Foreground="#6558FF" Margin="0,3,0,0"/><TextBlock Text="{Binding ExePath}" FontSize="8" Foreground="#8A90A2" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <RadioButton Grid.Column="1" GroupName="browser" IsChecked="{Binding IsSelected}" Checked="Browser_Checked" Tag="{Binding}" VerticalAlignment="Top" Margin="8,1,0,0"/>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </Border>

        <Border x:Name="FirstSetupCard" Background="#FFFFFF" CornerRadius="22" Padding="20" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="FIRST-TIME BROWSER ACTIVATION" FontSize="9" FontWeight="Bold" Foreground="#6558FF"/>
            <TextBlock Text="Finish browser setup once" FontSize="18" FontWeight="Bold" Foreground="#151826" Margin="0,4,0,0"/>
            <TextBlock Text="The extension files can be installed automatically, but Chrome does not allow an ordinary app to silently enable Developer mode or click Load unpacked. These three steps are required once; future SnapStream updates reuse the same folder." TextWrapping="Wrap" FontSize="10" LineHeight="16" Foreground="#6F7487" Margin="0,6,0,14"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#F8F9FD" CornerRadius="14" Padding="12"><StackPanel><TextBlock Text="1" FontSize="18" FontWeight="Bold" Foreground="#6558FF"/><TextBlock Text="Open Extensions" FontWeight="Bold" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="SnapStream opens the correct extensions page in the browser you selected." FontSize="9" TextWrapping="Wrap" Foreground="#6F7487" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Grid.Column="2" Background="#F8F9FD" CornerRadius="14" Padding="12"><StackPanel><TextBlock Text="2" FontSize="18" FontWeight="Bold" Foreground="#6558FF"/><TextBlock Text="Enable Developer mode" FontWeight="Bold" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="Turn on the browser's Developer mode toggle. This security control cannot be switched by SnapStream." FontSize="9" TextWrapping="Wrap" Foreground="#6F7487" Margin="0,4,0,0"/></StackPanel></Border>
              <Border Grid.Column="4" Background="#F8F9FD" CornerRadius="14" Padding="12"><StackPanel><TextBlock Text="3" FontSize="18" FontWeight="Bold" Foreground="#6558FF"/><TextBlock Text="Load unpacked" FontWeight="Bold" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="Click Load unpacked and select the SnapStream Extension folder. The path is copied automatically." FontSize="9" TextWrapping="Wrap" Foreground="#6F7487" Margin="0,4,0,0"/></StackPanel></Border>
            </Grid>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Open browser setup + copy path" Click="GuidedSetup_Click"/><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy extension folder" Click="CopyPath_Click"/></Grid>
          </StackPanel>
        </Border>

        <Border Background="#FFFFFF" CornerRadius="22" Padding="20">
          <StackPanel>
            <TextBlock Text="Install / Update" FontWeight="Bold" FontSize="16" Foreground="#151826"/>
            <TextBlock x:Name="StatusText" Text="Ready" Margin="0,5,0,12" FontSize="10" Foreground="#6F7487" TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,15"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="InstallButton" Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Install latest" Click="InstallButton_Click"/><Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Open browser setup" Click="GuidedSetup_Click"/></Grid>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Open extension folder" Click="OpenFolder_Click"/><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Copy folder path" Click="CopyPath_Click"/><Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="Open extensions page" Click="OpenExtensions_Click"/></Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
